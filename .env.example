# ---------------------------------------------------------------------------
# SUMO — environment variables
# Copy this file to `.env.local` (or `.env`) and fill in real values.
# Only variables prefixed with NEXT_PUBLIC_ are ever exposed to the browser.
# ---------------------------------------------------------------------------

# Privy — dashboard.privy.io → your app → Configuration → App settings → Basics
# (App ID is shown there; create the App secret under "API keys").
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# X / Twitter OAuth 2.0 credentials.
# Only needed if you configure your own X app as a custom login provider inside
# Privy (Login Methods → Socials → X). Not read by this app at runtime.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Optional: X API bearer token. Not used by the current wallet-age eligibility.
# Kept for future live follow/reply verification work.
# TWITTER_BEARER_TOKEN=

# Etherscan API v2 key — REQUIRED for wallet-age eligibility.
# Server-side only: reads the wallet's first Ethereum transaction.
# Get it at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Minimum wallet age. Default 3 (strictly older than 3 years).
# WALLET_MIN_AGE_YEARS=3

# ---------------------------------------------------------------------------
# Database (simple JSON file, no database server)
# ---------------------------------------------------------------------------
# Where the JSON database lives. Relative paths resolve from the project root.
# The file is created automatically on the first write.
# DATA_FILE=./data/sumo.json

# ---------------------------------------------------------------------------
# Optional / development
# ---------------------------------------------------------------------------
# Task verification mode: `mock` (always succeeds after 2s — MVP default) or
# `live` (real X API checks; not implemented yet, routes answer 501).
# TASKS_VERIFY_MODE=mock

# Override the Etherscan API base URL (handy for local stubs).
# ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
